#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

SCRIPT_NAME="$(basename "$0")"
BASE_DIR="${HOME}/.kube"
BACKUP_DIR="${BASE_DIR}/backups"

# garantir pasta de backups
mkdir -p "${BACKUP_DIR}"

TMP_CURRENT=""
TMP_WORK=""

MERGE_FILE=""
POS_NEW_CONFIG=""
RENAME_OLD=""
RENAME_NEW=""
DELETE_CONTEXT=""
PROJECT=""

log() {
  echo "[$SCRIPT_NAME] $*"
}

err() {
  echo "[$SCRIPT_NAME] ERROR: $*" >&2
}

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME [OPTIONS] [NEW_KUBECONFIG]

Description:
  Operates on a project master kubeconfig:

    ~/.kube/config-<project>

  - Can merge a new kubeconfig (via NEW_KUBECONFIG or -m).
  - Can rename a context (-r).
  - Can remove a context (-d).
  - Can combine multiple operations.

  If -p/--project is not provided:
    - the script lists existing projects (config-*);
    - lets you choose one;
    - or create new (if there's a file to merge).

Options:
  -h, --help
      Show this help and exit.

  -p NAME, --project NAME
      Project name (uses ~/.kube/config-NAME as master).
      If it doesn't exist, you'll be asked if you want to create it (when there's a merge).

  -m FILE, --merge FILE
      Kubeconfig file to add (merge) to the master.
      Alternatively, you can pass the path as a positional argument.

  -r OLD NEW, --rename-context OLD NEW
      Renames context OLD to NEW in the final kubeconfig.

  -d CTX, --delete-context CTX
      Removes context CTX from the final kubeconfig.

Notes:
  - At least one operation -m / NEW_KUBECONFIG, -r or -d is required.
  - If the master doesn't exist yet, a file for merge is required.

Examples:
  # Merge only (asks which project to add to)
  $SCRIPT_NAME kubeconfig-dev.yaml

  # Merge into a specific project
  $SCRIPT_NAME -p dev kubeconfig-dev.yaml

  # Rename context in a master chosen interactively
  $SCRIPT_NAME -r old-name new-name

  # Merge + rename in a specific project
  $SCRIPT_NAME -p dev -m kubeconfig-dev.yaml -r old-name new-name
EOF
}

cleanup() {
  [ -n "${TMP_CURRENT}" ] && [ -f "${TMP_CURRENT}" ] && rm -f "${TMP_CURRENT}"
  [ -n "${TMP_WORK}" ] && [ -f "${TMP_WORK}" ] && rm -f "${TMP_WORK}"
}
trap cleanup EXIT

# ---------- parsing de argumentos ----------

if [ $# -eq 0 ]; then
  err "No option/argument provided."
  usage
  exit 1
fi

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -p|--project)
      if [ $# -lt 2 ]; then
        err "Option $1 requires an argument: NAME."
        usage
        exit 1
      fi
      PROJECT="$2"
      shift 2
      ;;
    -m|--merge)
      if [ $# -lt 2 ]; then
        err "Option $1 requires an argument: FILE."
        usage
        exit 1
      fi
      if [ -n "$MERGE_FILE" ] || [ -n "$POS_NEW_CONFIG" ]; then
        err "A kubeconfig file has already been specified (via -m or positional argument)."
        exit 1
      fi
      MERGE_FILE="$2"
      shift 2
      ;;
    -r|--rename-context)
      if [ $# -lt 3 ]; then
        err "Option $1 requires two arguments: OLD NEW."
        usage
        exit 1
      fi
      RENAME_OLD="$2"
      RENAME_NEW="$3"
      shift 3
      ;;
    -d|--delete-context)
      if [ $# -lt 2 ]; then
        err "Option $1 requires an argument: CTX."
        usage
        exit 1
      fi
      DELETE_CONTEXT="$2"
      shift 2
      ;;
    -*)
      err "Unknown option: $1"
      usage
      exit 1
      ;;
    *)
      # First non-flag argument is NEW_KUBECONFIG
      if [ -n "$MERGE_FILE" ] || [ -n "$POS_NEW_CONFIG" ]; then
        err "More than one kubeconfig file provided."
        usage
        exit 1
      fi
      POS_NEW_CONFIG="$1"
      shift
      ;;
  esac
done

# Resolve merge source (if exists)
if [ -n "$POS_NEW_CONFIG" ]; then
  MERGE_FILE="$POS_NEW_CONFIG"
fi

if [ -z "$MERGE_FILE" ] && [ -z "$RENAME_OLD" ] && [ -z "$DELETE_CONTEXT" ]; then
  err "At least one operation is required: kubeconfig file, -r or -d."
  usage
  exit 1
fi

if ! command -v kubectl >/dev/null 2>&1; then
  err "kubectl not found in PATH."
  exit 1
fi

# ---------- validate merge file, if exists ----------

if [ -n "$MERGE_FILE" ]; then
  if [ ! -f "$MERGE_FILE" ]; then
    err "Merge file '$MERGE_FILE' does not exist."
    exit 1
  fi

  if ! kubectl --kubeconfig="$MERGE_FILE" config view >/dev/null 2>&1; then
    err "'$MERGE_FILE' does not appear to be a valid kubeconfig (kubectl could not read it)."
    exit 1
  fi

  log "New kubeconfig validated: $MERGE_FILE"
fi

# ---------- choose project if -p was not passed ----------

choose_project_interactive() {
  local projects=()
  local f name

  for f in "${BASE_DIR}"/config-*; do
    [ -f "$f" ] || continue
    name="${f##*/config-}"
    projects+=("$name")
  done

  if [ ${#projects[@]} -eq 0 ]; then
    # no projects yet
    if [ -z "$MERGE_FILE" ]; then
      err "No projects exist yet (no ~/.kube/config-<name>) and no kubeconfig was provided to create one."
      err "Run again passing a kubeconfig file (e.g., $SCRIPT_NAME path/to/kubeconfig)."
      exit 1
    fi
    echo "You don't have any projects defined yet."
    read -rp "Name for the new project (will create ~/.kube/config-<name>): " PROJECT
    if [ -z "$PROJECT" ]; then
      err "Empty project name, aborting."
      exit 1
    fi
    return
  fi

  echo "Available projects:"
  local i=1
  for name in "${projects[@]}"; do
    echo "  $i) $name"
    i=$((i + 1))
  done

  local create_idx=0
  if [ -n "$MERGE_FILE" ]; then
    create_idx=$i
    echo "  $create_idx) Create new project"
  fi

  echo
  read -rp "Choose the project number: " choice

  # validate number
  if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
    err "Invalid choice: '$choice' (not a number)."
    exit 1
  fi

  if [ "$choice" -ge 1 ] && [ "$choice" -le "${#projects[@]}" ]; then
    PROJECT="${projects[$((choice-1))]}"
    return
  fi

  if [ -n "$MERGE_FILE" ] && [ "$choice" -eq "$create_idx" ]; then
    read -rp "Name for the new project: " PROJECT
    if [ -z "$PROJECT" ]; then
      err "Empty project name, aborting."
      exit 1
    fi
    return
  fi

  err "Number out of range."
  exit 1
}

if [ -z "$PROJECT" ]; then
  echo "No project (-p) was specified."
  choose_project_interactive
fi

KUBE_CONFIG="${BASE_DIR}/config-${PROJECT}"
log "Selected project: ${PROJECT}"
log "Target master kubeconfig: ${KUBE_CONFIG}"

# ---------- if master doesn't exist yet ----------

if [ ! -f "$KUBE_CONFIG" ]; then
  if [ -z "$MERGE_FILE" ]; then
    err "Project '${PROJECT}' does not exist (${KUBE_CONFIG})."
    err "I can only create a new master if you also provide a kubeconfig to merge."
    exit 1
  fi

  echo "Project '${PROJECT}' does not exist yet (file ${KUBE_CONFIG})."
  read -rp "Do you want to create a new master based on '${MERGE_FILE}'? [y/N]: " ans
  ans="${ans:-N}"
  case "$ans" in
    y|Y)
      log "Creating new kubeconfig master at ${KUBE_CONFIG}..."
      mkdir -p "$(dirname "$KUBE_CONFIG")"
      cp "$MERGE_FILE" "$KUBE_CONFIG"
      ;;
    *)
      log "Operation cancelled by user."
      exit 1
      ;;
  esac

  # apply rename/delete if requested
  if [ -n "$RENAME_OLD" ]; then
    log "Renaming context '${RENAME_OLD}' to '${RENAME_NEW}' in new master..."
    if ! KUBECONFIG="$KUBE_CONFIG" kubectl config rename-context "$RENAME_OLD" "$RENAME_NEW"; then
      err "Failed to rename context '${RENAME_OLD}' to '${RENAME_NEW}' in ${KUBE_CONFIG}."
      exit 1
    fi
  fi

  if [ -n "$DELETE_CONTEXT" ]; then
    log "Removing context '${DELETE_CONTEXT}' from new master..."
    if ! KUBECONFIG="$KUBE_CONFIG" kubectl config delete-context "$DELETE_CONTEXT"; then
      err "Failed to remove context '${DELETE_CONTEXT}' in ${KUBE_CONFIG}."
      exit 1
    fi
  fi

  # create/update unique backup for this project
  BACKUP="${BACKUP_DIR}/${PROJECT}.bak"
  cp "$KUBE_CONFIG" "$BACKUP"
  log "Project backup created/updated at: $BACKUP"

  log "New kubeconfig master created at: $KUBE_CONFIG"

  # Force update of active kubeconfig via kxswap (if exists)
  if command -v kxswap >/dev/null 2>&1; then
    kxswap "${PROJECT}" || log "Warning: kxswap failed to apply active configuration."
  fi

  exit 0
fi

# ---------- master already exists: normalize and apply operations ----------

TMP_CURRENT="$(mktemp "${TMPDIR:-/tmp}/kube-current.XXXXXX")"
TMP_WORK="$(mktemp "${TMPDIR:-/tmp}/kube-work.XXXXXX")"

# Normalize current config
if ! kubectl --kubeconfig="$KUBE_CONFIG" config view --merge --flatten > "$TMP_CURRENT" 2>/dev/null; then
  err "The master kubeconfig at '$KUBE_CONFIG' appears invalid (kubectl could not read it)."
  err "For safety, nothing was changed. Fix the current file or make a manual backup and try again."
  exit 1
fi

# Starting point for TMP_WORK:
if [ -n "$MERGE_FILE" ]; then
  if ! KUBECONFIG="${KUBE_CONFIG}:${MERGE_FILE}" \
    kubectl config view --merge --flatten > "$TMP_WORK" 2>/dev/null; then
    err "Failed to generate merged kubeconfig (kubectl config view failed)."
    exit 1
  fi
else
  cp "$TMP_CURRENT" "$TMP_WORK"
fi

# Apply rename/delete on TMP_WORK, if requested
if [ -n "$RENAME_OLD" ]; then
  log "Renaming context '${RENAME_OLD}' to '${RENAME_NEW}' in work config..."
  if ! KUBECONFIG="$TMP_WORK" kubectl config rename-context "$RENAME_OLD" "$RENAME_NEW"; then
    err "Failed to rename context '${RENAME_OLD}' to '${RENAME_NEW}' in work config."
    exit 1
  fi
fi

if [ -n "$DELETE_CONTEXT" ]; then
  log "Removing context '${DELETE_CONTEXT}' in work config..."
  if ! KUBECONFIG="$TMP_WORK" kubectl config delete-context "$DELETE_CONTEXT"; then
    err "Failed to remove context '${DELETE_CONTEXT}' in work config."
    exit 1
  fi
fi

# Check if there were effective changes
if cmp -s "$TMP_CURRENT" "$TMP_WORK"; then
  log "Nothing to do: final master kubeconfig is the same as current."
  exit 0
fi

# Unique backup of current master
BACKUP="${BACKUP_DIR}/${PROJECT}.bak"
cp "$KUBE_CONFIG" "$BACKUP"
log "Project backup created/updated at: $BACKUP"

# Apply the new master file
mv "$TMP_WORK" "$KUBE_CONFIG"
# TMP_CURRENT is cleaned via trap

log "Update completed at: $KUBE_CONFIG"
[ -n "$MERGE_FILE" ] && log "Merge applied from: $MERGE_FILE"
[ -n "$RENAME_OLD" ] && log "Context '${RENAME_OLD}' was renamed to '${RENAME_NEW}'."
[ -n "$DELETE_CONTEXT" ] && log "Context '${DELETE_CONTEXT}' was removed from master kubeconfig."
log "If something goes wrong, you can restore from: $BACKUP"

# apply via kxswap automatically
if command -v kxswap >/dev/null 2>&1; then
  kxswap "${PROJECT}" || log "Warning: kxswap failed to apply active configuration."
fi