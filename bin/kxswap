#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

SCRIPT_NAME="$(basename "$0")"
BASE_DIR="${HOME}/.kube"

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME [<name>]

Description:
  Swaps the active kubeconfig (~/.kube/config) to the specified project.
  The file ~/.kube/config-<name> will be copied to ~/.kube/config.

  If no argument is provided, an interactive menu will be shown to select
  from available projects.

Options:
  -h, --help    Show this help and exit.

Examples:
  $SCRIPT_NAME dev
  $SCRIPT_NAME prod
  $SCRIPT_NAME              # Interactive selection
EOF
}

err() {
  echo "[$SCRIPT_NAME] ERROR: $*" >&2
}

# Interactive menu with arrow keys
interactive_select() {
  local projects=()
  local f name
  
  # Collect projects
  for f in "${BASE_DIR}"/config-*; do
    [ -f "$f" ] || continue
    name="${f##*/config-}"
    projects+=("$name")
  done
  
  if [ ${#projects[@]} -eq 0 ]; then
    err "No projects found in ${BASE_DIR}/config-*"
    err "Use kxconfig to create a project first."
    exit 1
  fi
  
  local selected=0
  local key
  local restore_terminal=false
  local TTY_DEV=""
  
  # Check if we have a TTY available
  if [ -t 0 ] && [ -c /dev/tty ]; then
    TTY_DEV="/dev/tty"
  else
    # Fallback to stderr for output, stdin for input
    TTY_DEV=""
  fi
  
  # Cleanup function to restore terminal
  cleanup_terminal() {
    if [ "$restore_terminal" = true ] && [ -n "$TTY_DEV" ]; then
      tput cnorm >"$TTY_DEV" 2>/dev/null || true  # Show cursor
      tput ed >"$TTY_DEV" 2>/dev/null || true     # Clear to end of screen
    fi
  }
  
  # Hide cursor (only if TTY available)
  if [ -n "$TTY_DEV" ]; then
    tput civis >"$TTY_DEV" 2>/dev/null || true
    restore_terminal=true
    trap cleanup_terminal EXIT INT TERM
  fi
  
  while true; do
    # Clear screen and move to top (only if TTY available)
    if [ -n "$TTY_DEV" ]; then
      tput clear >"$TTY_DEV" 2>/dev/null || true
      tput cup 0 0 >"$TTY_DEV" 2>/dev/null || true
    fi
    
    if [ -n "$TTY_DEV" ]; then
      echo "Select a project (use ↑↓ arrows, Enter to select, Ctrl+C to cancel):" >"$TTY_DEV"
      echo "" >"$TTY_DEV"
    else
      echo "Select a project (use ↑↓ arrows, Enter to select, Ctrl+C to cancel):" >&2
      echo "" >&2
    fi
    
    # Display projects with selection indicator
    local i=0
    for name in "${projects[@]}"; do
      if [ $i -eq $selected ]; then
        if [ -n "$TTY_DEV" ]; then
          tput rev >"$TTY_DEV" 2>/dev/null || true  # Reverse video for selected
          echo "  > $name" >"$TTY_DEV"
          tput sgr0 >"$TTY_DEV" 2>/dev/null || true  # Reset formatting
        else
          echo "  > $name" >&2
        fi
      else
        if [ -n "$TTY_DEV" ]; then
          echo "    $name" >"$TTY_DEV"
        else
          echo "    $name" >&2
        fi
      fi
      i=$((i + 1))
    done
    
    # Read keypress from terminal
    if [ -n "$TTY_DEV" ]; then
      IFS= read -rsn1 key <"$TTY_DEV" 2>/dev/null || key=""
    else
      IFS= read -rsn1 key 2>/dev/null || key=""
    fi
    
    # Check for escape sequence (arrow keys)
    if [ "$key" = $'\x1b' ]; then
      if [ -n "$TTY_DEV" ]; then
        read -rsn1 -t 0.1 key <"$TTY_DEV" 2>/dev/null || key=""
      else
        read -rsn1 -t 0.1 key 2>/dev/null || key=""
      fi
      if [ "$key" = '[' ]; then
        if [ -n "$TTY_DEV" ]; then
          read -rsn1 -t 0.1 key <"$TTY_DEV" 2>/dev/null || key=""
        else
          read -rsn1 -t 0.1 key 2>/dev/null || key=""
        fi
        case "$key" in
          'A') # Up arrow
            if [ $selected -gt 0 ]; then
              selected=$((selected - 1))
            fi
            ;;
          'B') # Down arrow
            if [ $selected -lt $((${#projects[@]} - 1)) ]; then
              selected=$((selected + 1))
            fi
            ;;
        esac
      fi
    elif [ "$key" = "" ]; then
      # Enter key (empty string when Enter is pressed)
      break
    elif [ "$key" = $'\x03' ]; then
      # Ctrl+C
      cleanup_terminal
      exit 1
    fi
  done
  
  # Restore terminal
  cleanup_terminal
  trap - EXIT INT TERM 2>/dev/null || true
  
  # Return selected project (only this goes to stdout)
  echo "${projects[$selected]}"
}

# Check if help is requested
if [ $# -gt 0 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  usage
  exit 0
fi

# If no arguments, use interactive selection
if [ $# -eq 0 ]; then
  NAME=$(interactive_select)
  # Trim whitespace from the selected name
  NAME=$(echo "$NAME" | tr -d '\n\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
elif [ $# -gt 1 ]; then
  err "Too many arguments provided."
  usage
  exit 1
else
  NAME="$1"
fi

# Validate that NAME is not empty
if [ -z "$NAME" ]; then
  err "Project name is empty."
  exit 1
fi

SRC="$HOME/.kube/config-$NAME"
DEST="$HOME/.kube/config"

# Validate source
if [ ! -f "$SRC" ]; then
  err "Source file does not exist: $SRC"
  err "Make sure the project '$NAME' exists (use kxconfig to create it)."
  exit 1
fi

# Validate kubeconfig before copying (if kubectl is available)
if command -v kubectl >/dev/null 2>&1; then
  if ! kubectl --kubeconfig="$SRC" config view >/dev/null 2>&1; then
    err "'$SRC' does not appear to be a valid kubeconfig (kubectl could not read it)."
    exit 1
  fi
fi

# Create destination directory if it doesn't exist
mkdir -p "$(dirname "$DEST")"

# Copy kubeconfig
if ! cp "$SRC" "$DEST" 2>/dev/null; then
  err "Failed to copy kubeconfig from '$SRC' to '$DEST'."
  err "Check permissions on the ~/.kube/ directory"
  exit 1
fi

# Force default namespace (silent)
if command -v kubectl >/dev/null 2>&1; then
  KUBECONFIG="$DEST" kubectl config set-context --current --namespace=default >/dev/null 2>&1 || true
fi

echo "Config applied: $NAME"