#!/usr/bin/env bash

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Uso: kxswap <nome>"
  exit 1
fi

NAME="$1"
SRC="$HOME/.kube/config-$NAME"
DEST="$HOME/.kube/config"

# validar origem
if [ ! -f "$SRC" ]; then
  echo "Erro: Ficheiro não existe: $SRC"
  exit 1
fi

# swap silencioso
cp "$SRC" "$DEST" 2>/dev/null || {
  echo "Erro ao aplicar kubeconfig."
  exit 1
}

# forçar namespace default sem output
if command -v kubectl >/dev/null 2>&1; then
  KUBECONFIG="$DEST" kubectl config set-context --current --namespace=default >/dev/null 2>&1 || {
    echo "Aviso: não foi possível definir o namespace 'default'."
  }
fi

# output básico
echo "Config aplicada: $NAME"