#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

SCRIPT_NAME="$(basename "$0")"

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <name>

Description:
  Swaps the active kubeconfig (~/.kube/config) to the specified project.
  The file ~/.kube/config-<name> will be copied to ~/.kube/config.

Options:
  -h, --help    Show this help and exit.

Examples:
  $SCRIPT_NAME dev
  $SCRIPT_NAME prod
EOF
}

err() {
  echo "[$SCRIPT_NAME] ERROR: $*" >&2
}

if [ $# -eq 0 ]; then
  err "No argument provided."
  usage
  exit 1
fi

# Check if help is requested
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  usage
  exit 0
fi

if [ $# -gt 1 ]; then
  err "Too many arguments provided."
  usage
  exit 1
fi

NAME="$1"
SRC="$HOME/.kube/config-$NAME"
DEST="$HOME/.kube/config"

# Validate source
if [ ! -f "$SRC" ]; then
  err "Source file does not exist: $SRC"
  err "Make sure the project '$NAME' exists (use kxconfig to create it)."
  exit 1
fi

# Validate kubeconfig before copying (if kubectl is available)
if command -v kubectl >/dev/null 2>&1; then
  if ! kubectl --kubeconfig="$SRC" config view >/dev/null 2>&1; then
    err "'$SRC' does not appear to be a valid kubeconfig (kubectl could not read it)."
    exit 1
  fi
fi

# Create destination directory if it doesn't exist
mkdir -p "$(dirname "$DEST")"

# Copy kubeconfig
if ! cp "$SRC" "$DEST" 2>/dev/null; then
  err "Failed to copy kubeconfig from '$SRC' to '$DEST'."
  err "Check permissions on the ~/.kube/ directory"
  exit 1
fi

# Force default namespace (silent)
if command -v kubectl >/dev/null 2>&1; then
  KUBECONFIG="$DEST" kubectl config set-context --current --namespace=default >/dev/null 2>&1 || true
fi

echo "Config applied: $NAME"